# Configuration for Stellar Testnet. Copy to .env for local overrides.
#
# Two kinds of value live here, and the prefix is the difference:
#   VITE_*  is compiled into the client bundle verbatim. Public, never secret.
#   others  are read only by the serverless functions in api/, and only when
#           they run — which `npm run dev` does not do. `vercel dev` does.
#
# This file is committed. Keep real secrets in .env (gitignored) and in the
# hosting dashboard; the entries below are placeholders that name what is
# needed, not values.
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_FRIENDBOT_URL=https://friendbot.stellar.org
VITE_STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Everspan v0 contract IDs (Testnet). Redeploy with scripts/deploy-testnet.sh
# and update these. See README for the current deployment.
VITE_MYT_CONTRACT_ID=CDN42W36GJ2AGPWGDMEL2BUEKCGCVCQ4GRLFXUBPTQUDIEDWQQHZG3TR
VITE_SY_VAULT_CONTRACT_ID=CBPCPCDCHGAJUU7BID7DOOKBTIWTRIYYZXGL2YBMJ64KNR53YJD4ANZE
VITE_SPLITTER_CONTRACT_ID=CCBQ4PWTSBKL6RTSL5CFUPVX3SZMLODDJKGH6XFVRZU6UPFXAHHZBSBR
VITE_AMM_CONTRACT_ID=CD4B2YYEMDDRVOFH6EWIXFMP5ZX3YCLMALTYRTGSHCNXDDV3XWNIMILD
# Second market: SY over a real Blend lending position (Phase 6). Leave these
# empty to ship a mock-only build — the market switcher hides itself.
# Deploy with: ./scripts/deploy-testnet.sh --with-blend
VITE_BLEND_SY_VAULT_CONTRACT_ID=CAWXCCBE7RY26LVVWN5QWWOARGDABGQKJMWAYPCM52TT5QZM2UCOGA7J
VITE_BLEND_SPLITTER_CONTRACT_ID=CDRDDE3NQAY5RPQ4KN7MRAOUTJTWITWLSZQWAFP4XRIN23VG7UHE6YOU
VITE_BLEND_AMM_CONTRACT_ID=CBT5RSS37MYLQYEBOYM4GKWSY2MWKQW3RPUPRKQHUVZNKXLZ76TJED75
# The reserve the vault supplies into — testnet XLM (native SAC), friendbot-fundable.
VITE_BLEND_ASSET_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Optional — WalletConnect project id (free: https://dashboard.reown.com).
# Without it the wallet picker only offers wallets that inject into the page,
# which on a phone means none of the extension wallets can connect: Freighter's
# module reports itself unavailable on mobile by design and expects
# WalletConnect instead. Set this to let phones connect.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional — public browser DSN from a Sentry React project. Leave empty to
# disable error reporting locally.
VITE_SENTRY_DSN=

# Optional — shareable Google Form URL for the app's Feedback link. Leave
# empty until the form exists; the link stays hidden when unset.
VITE_FEEDBACK_FORM_URL=

# ---------------------------------------------------------------------------
# PASSKEY-ENTRY — the Testnet-only, wallet-free way in. See docs/passkey.md.
# Remove this whole block when the feature comes out.
# ---------------------------------------------------------------------------

# The kill switch. passkey-kit's canonical smart-wallet contract, already
# deployed on Testnet — nothing to install. Clearing this turns the entry point
# off everywhere without a rebuild; it also refuses to arm off Testnet.
VITE_PASSKEY_WALLET_WASM_HASH=97ce047884106b1c6c3bb40b8973cc48db1c4dad95c9e20462bf2c701daa764e

# Server-only from here down. NEVER give these a VITE_ prefix: that would
# compile a funded signing key into the JavaScript every visitor downloads.

# Testnet S… key that pays relay fees and submits on a smart wallet's behalf.
# Fund the matching G… address with friendbot.
SPONSOR_SECRET=

# Testnet S… key that sends starting funds to a new wallet. May be the same key
# as SPONSOR_SECRET for a first pass; falls back to it when unset.
DISPENSER_SECRET=

# What the relay is allowed to sponsor, by address: the fixed per-market
# deployments (underlying, SY vault, Market, AMM) for both markets.
RELAY_ALLOWED_CONTRACTS=CDN42W36GJ2AGPWGDMEL2BUEKCGCVCQ4GRLFXUBPTQUDIEDWQQHZG3TR,CBPCPCDCHGAJUU7BID7DOOKBTIWTRIYYZXGL2YBMJ64KNR53YJD4ANZE,CCBQ4PWTSBKL6RTSL5CFUPVX3SZMLODDJKGH6XFVRZU6UPFXAHHZBSBR,CD4B2YYEMDDRVOFH6EWIXFMP5ZX3YCLMALTYRTGSHCNXDDV3XWNIMILD,CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC,CAWXCCBE7RY26LVVWN5QWWOARGDABGQKJMWAYPCM52TT5QZM2UCOGA7J,CDRDDE3NQAY5RPQ4KN7MRAOUTJTWITWLSZQWAFP4XRIN23VG7UHE6YOU,CBT5RSS37MYLQYEBOYM4GKWSY2MWKQW3RPUPRKQHUVZNKXLZ76TJED75

# What the relay is allowed to sponsor, by code: PT, YT and the smart wallet.
# PT and YT are factory-deployed per maturity, so their addresses cannot be
# listed ahead of time. On a redeploy, ADD the new hash and keep the old one —
# dropping it locks existing holders out of their own tokens.
RELAY_ALLOWED_WASM=ad5b05a32247f328260dc13fdc6b5b00dd595a27a6c0da01e7152eef5eeb7e69,f9d2c231edc02b90907e2c23ff41b60ecd82e3fd98a11b3babc05aa6496c1a79,97ce047884106b1c6c3bb40b8973cc48db1c4dad95c9e20462bf2c701daa764e

# Optional — override the Soroban RPC the functions talk to.
RELAY_RPC_URL=
